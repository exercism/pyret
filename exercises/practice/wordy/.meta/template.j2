{%- macro call(case) -%}
  {{ case.property_function }}({{ case.given | quote }})
{%- endmacro -%}

{%- macro check(case) -%}
  {%- if not case.expect_error -%}
    is {{ case.expected | quote }}
  {%- else -%}
    raises {{ case.expect_error_msg | quote }}
  {%- endif -%}
{%- endmacro -%}

use context starter2024

{{ include_solution }}

{%- for case in cases %}

check {{ case.descriptions | join(" -> ") | quote }}:
  {{ call(case) }} {{ check(case) }}
end
{%- endfor %}

{%- macro header() -%}
use context starter2024
{%- endmacro -%}


{%- macro write_vars(case) -%}
  {%- for var, value in case.input.items() %}{% if (value | quote) is exceeds(30) %}
  {{ var }} = {{ value | quote }}
  {%- endif -%}{%- endfor %}
  {%- if not case.expect_error and case.expected | quote | length > 50 %}
  expected = {{ case.expected | quote }}
  {%- endif -%}
  {%- if (not case.expect_error and case.expected | quote | length > 50) or (case.input.values() | select("exceeds", 30) | join("")) -%}{{ "\n" }}{%- endif %}
{%- endmacro %}


{%- macro call_func_with_vars(func, case) -%}
  {{ func }}(
    {%- for var, value in case.input.items() -%}
      {%- if (value | quote) is exceeds(30) -%}
        {{- var -}}
      {%- else -%}
        {{- value | quote -}}
      {%- endif -%}
      {%- if not loop.last -%}, {% endif %}
    {%- endfor -%}
  )
{%- endmacro %}


{%- macro check_result(case) -%}
  {%- if case.expect_error -%}
    raises {{ case.expect_error_msg | quote }}
  {%- elif case.expected | quote | length > 50 -%}
      is expected
  {%- else -%}
    is {{ case.expected | quote }}
  {%- endif %}
end
{%- endmacro %}


{%- macro generic_test_case(case, description, func) -%}
check {{ description | quote }}:
  {{- write_vars(case) }}
  {{ call_func_with_vars(func, case) }} {{ check_result(case) }}
{%- endmacro %}


{%- macro generic_suite(include, cases, func=None, vars=False) -%}
{{ header() }}

{{ include }}

{%- for case in cases %}

{{
  generic_test_case(
    case,
    case.descriptions | join(" -> "),
    func or case.property_function,
  )
}}
{%- endfor %}
{%- endmacro %}

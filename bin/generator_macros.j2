{%- macro header() -%}
use context starter2024
{%- endmacro -%}


{%- macro write_vars(case, name_map) -%}
  {%- for var, value in case.input.items() %}
  {{ name_map.get(var, var) | camel_to_kebab }} = {{ value | quote }}
  {%- endfor %}
  {%- if not case.expect_error %}
  expected = {{ case.expected | quote }}
  {%- endif %}
  {%- if case.input or not case.expect_error %}{{ "\n" }}{% endif %}
{%- endmacro -%}


{%- macro call_func_with_vars(func, case, name_map) -%}
  {{ func }}(
    {%- for var, value in case.input.items() -%}
      {{- name_map.get(var, var) | camel_to_kebab -}}
      {%- if not loop.last -%}, {% endif %}
    {%- endfor -%}
  )
{%- endmacro %}


{%- macro check_result(case) -%}
  {%- if case.expect_error -%}
    raises {{ case.expect_error_msg | quote }}
  {%- else -%}
      is expected
  {%- endif %}
end
{%- endmacro %}


{%- macro generic_test_case(case, description, func, name_map={}, var_writer=write_vars) -%}
check {{ description | quote }}:
  {{- var_writer(case, name_map) }}
  {{ call_func_with_vars(func, case, name_map) }} {{ check_result(case) }}
{%- endmacro %}


{%- macro generic_suite(include, cases, func=None, name_map={}, func_map={}, var_writer=write_vars) -%}
{{ header() }}

{{ include }}

{%- for case in cases %}

{{
  generic_test_case(
    case,
    case.descriptions | join(" -> "),
    func_map.get(func or case.property_function, func or case.property_function),
    name_map,
    var_writer,
  )
}}
{%- endfor %}
{%- endmacro %}

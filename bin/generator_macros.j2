{%- macro header() -%}
use context starter2024
{%- endmacro -%}


{%- macro write_vars(case, name_map, multiline=[]) -%}
  {%- for var, value in case.input.items() %}
    {%- if var in multiline and "\n" in value %}
  {{ name_map.get(var, var) | camel_to_kebab }} = ```
{{ value | replace("\\n", "\n") }}
```
    {%- else %}
  {{ name_map.get(var, var) | camel_to_kebab }} = {{ value | quote }}
    {%- endif %}
  {%- endfor %}
  {%- if not case.expect_error %}
    {%- if "expected" in multiline and case.expected is iterable and not case.expected is string and case.expected | length > 1 %}
  expected = [list:
      {%- for i in case.expected %}
    {{ i | quote }}{% if loop.last %}]{% else %},{% endif %}
      {%- endfor %}

    {%- else %}
  expected = {{ case.expected | quote }}
    {%- endif %}
  {%- endif %}
  {%- if case.input or not case.expect_error %}{{ "\n" }}{% endif %}
{%- endmacro -%}


{%- macro call_func_with_vars(func, case, name_map) -%}
  {{ func }}(
    {%- for var, value in case.input.items() -%}
      {{- name_map.get(var, var) | camel_to_kebab -}}
      {%- if not loop.last -%}, {% endif %}
    {%- endfor -%}
  )
{%- endmacro %}


{%- macro check_result(case) -%}
  {%- if case.expect_error -%}
    raises {{ case.expect_error_msg | quote }}
  {%- else -%}
      is expected
  {%- endif %}
{%- endmacro %}


{%- macro generic_test_case(case, description, func, name_map={}, var_writer=write_vars, multiline=[], result_check=check_result) -%}
check {{ description | quote }}:
  {{- var_writer(case, name_map, multiline=multiline) }}
  {{ call_func_with_vars(func, case, name_map) }} {{ result_check(case) }}
end
{%- endmacro %}


{%- macro generic_suite(include, cases, func=None, name_map={}, func_map={}, var_writer=write_vars, multiline=[], result_check=check_result) -%}
{{ header() }}

{{ include }}

{%- for case in cases %}

{{
  generic_test_case(
    case,
    case.descriptions | join(" -> "),
    func_map.get(func or case.property_function, func or case.property_function),
    name_map=name_map,
    var_writer=var_writer,
    multiline=multiline,
    result_check=result_check,
  )
}}
{%- endfor %}
{%- endmacro %}
